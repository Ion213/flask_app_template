{% extends 'public/public_nav.html' %}

{% block title %}
    SignUp
{% endblock %}

{% block content %}

<link rel="stylesheet" href="{{ url_for('static', filename='css/auth/auth.css') }}">
<link rel="stylesheet" href="{{ url_for('static', filename='css/sweetAlert.css') }}">


<div class="center-wrapper">

  <div class="card">
    <h4 class="mb-4 text-center">Sign Up</h4>

    <form id="signup_form">

      <div class="form-group mb-3"">
        <div class="input-group">
          <div class="form-floating">
            <input type="text" class="form-control" id="first_name" placeholder="First Name" required>
            <label for="first_name">First Name</label>
          </div>
          <div class="form-floating">
            <input type="text" class="form-control" id="last_name" placeholder="Last Name" required>
            <label for="last_name">Last Name</label>
          </div>
        </div> 
      </div>

      <div class="form-group mb-3"">
        <div class="input-group">
          <div class="form-floating">
            <input type="text" class="form-control" id="user_id" placeholder="ID No." pattern="^\d+(?:-\d+)+$" required>
            <label for="user_id">ID No.</label>
          </div>
          <div class="form-floating">
            <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
            <label for="email">Email</label>
          </div>
        </div>
        <small id="id-format" class="text-danger d-none"></small>
        <small id="email-format" class="text-danger d-none"></small>
      </div>
      
      <div class="form-group mb-3"">
        <div class="input-group">
        
          <div class="form-floating">
            <input type="password" class="form-control" id="password" placeholder="Password" minlength="6" maxlength="20" required>
            <label for="password">Password</label>
          </div>
          <button class="password-toggle" type="button" id="togglePassword" 
          style="background-color: rgba(0, 255, 255, 0.464); border:0px; border-radius:5px">
                <i class="fas fa-eye"></i>
          </button>

          <div class="form-floating">
            <input type="password" class="form-control" id="confirm_password" placeholder="Confirm Password" minlength="6" maxlength="20" required>
            <label for="confirm_password">Confirm Pass.</label>
          </div>
          <button class="password-toggle" type="button" id="toggleConfirmPassword" 
          style="background-color: rgba(0, 255, 255, 0.464); border:0px; border-radius:5px">
                <i class="fas fa-eye"></i>
          </button>

        </div>
        <small id="password-strength" class="text-danger d-none"></small>
        <small id="password-match" class="text-danger d-none"></small>
      </div>

      <button class="btn btn-primary w-100" id="signup-btn"  type="submit">Create Account</button>

      <hr>

      <div class="mt-3 text-center">
        <p>Already have an account? <a href="{{ url_for('login.login_page') }}" class="small">Login</a></p>
      </div>

    </form>
    
  </div>
  
</div>

  <script src="{{ url_for('static', filename='js/auth/form_check/signup_form_checker.js') }}"></script>
 <script src="{{ url_for('static', filename='js/auth/signup.js') }}"></script>



{% endblock %}
